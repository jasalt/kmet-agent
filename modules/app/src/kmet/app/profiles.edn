;; kmet2's built-in composition data (new-app.md § Profiles and presets).
;;
;; A bundle is reusable rows plus patches; a profile stacks bundles in order
;; (`[:bundle/name extra-layer?]`) and then adds its own rows and patches.
;; A row names a plugin source var — never a keyword registry key — and its
;; :id defaults to the plugin's :name (kmet.app.catalog).
;;
;; Landing 1 ships the composition machinery; landing 2 adds the first row —
;; the event bus — and each later landing adds its own (the registries and
;; tools at 3, the agents and sessions at 4, the UI and modes at 5–7).
;; `kmet --app new --dump-config` prints this composition without booting
;; anything; a plain run boots it (kmet.app.runtime).
{:bundles
 {:bundle/minimal
  {:rows [;; The extension host: it binds the process-wide services it may not
          ;; require (its own tag registry, the ctx an :inject mounts under) so
          ;; a run's hooks resolve. No service key: the binding is the effect.
          ;; No resource registries either — installing an extension is still kmet1's,
          ;; and those registries' loaders move with the modes (landing 5).
          {:id :extensions :plugin kmet.app.extensions/plugin}
          {:id :events :plugin kmet.app.events/plugin}
          {:id :tools :plugin kmet.app.tools/plugin}
          {:id :commands :plugin kmet.app.registries/commands}
          {:id :prompts :plugin kmet.app.registries/prompts}
          {:id :skills :plugin kmet.app.registries/skills}
          ;; The prompt builder a driver hands its state (7a): the app's pure
          ;; builder over the skills registry above. What a prompt is *about*
          ;; stays the caller's — only it knows which agent it is building for.
          {:id :system-prompt :plugin kmet.app.system-prompt/plugin}
          ;; The session log and its storage backend: EDNL files, one log per
          ;; context. :sessions injects :sessionPersistence, so the pair is
          ;; active whichever order the rows mount in.
          {:id :session-persistence :plugin kmet.agent.session.backend/plugin}
          {:id :sessions :plugin kmet.app.sessions/plugin}
          ;; Derived state over the log: the durable inbox (a queued message is
          ;; a log fact, not a second in-memory list), the turn boundaries and
          ;; the token meter. The registry below rides on it: sending is an
          ;; append, and the driver that creates agents is the loop's (:agentLoop
          ;; at landing 7), so `create!` has no factory until one mounts.
          {:id :projections :plugin kmet.app.projections/plugin}
          {:id :agents :plugin kmet.app.agents/plugin}
          ;; The loop as the driver (7a): it registers the :agents factory, so
          ;; create! publishes a runnable agent — a state over the agent's ctx,
          ;; its own session, and the :systemPrompt row's builder.
          {:id :agent-loop :plugin kmet.app.loop.driver/plugin}
          ;; The delivery seam for a permission `:ask`. The policy itself is
          ;; NOT here: a policy decides per agent, so it mounts on the agent's
          ;; ctx (the kernel forbids a child shadowing a service its ancestor
          ;; provides — a per-agent value has to be the only provider on its
          ;; chain). The default approver denies: nobody can ask yet.
          {:id :approvals :plugin kmet.app.permissions/approvals}]
   :patch []}

 ;; The headless UI provider: the first implementation of the `:ui` contract
 ;; (kmet.app.ui), and the only one the profiles that draw nothing need. A
 ;; profile that renders stacks it after :bundle/minimal; print and rpc inject
 ;; :ui and bind `(:port (srce/get ctx :ui))`, and the server stacks it for the
 ;; per-connection surface landing 8 adds.
 :bundle/headless
 {:rows [{:id :ui :plugin kmet.ui.headless/plugin}]
  :patch []}

 ;; The gate as a bundle: one row, the policy, mounted wherever an agent's child
 ;; ctx should decide per agent. A profile stacks it at the root (the `:rpc-ask`
 ;; profile below); a *preset* mounts it on one agent's ctx
 ;; (`kmet.app.presets`), which is what the row's own docstring asks for — a
 ;; policy decides per agent, so it mounts on the agent's ctx.
 :bundle/gated
 {:rows [{:id :permissions :plugin kmet.app.permissions/permissions
          :config {:policy :ask-all}}]
  :patch []}}

 :profiles
 {:tui
  ;; the default profile: the TUI as a row. Its plugin is kmet1's interactive
  ;; mode mounted over this composition — the row is the whole difference
  ;; between the two entries for a TUI run (kmet.ui.tui).
  ;; :session-lifecycle says the mode opens the session itself, so the entry
  ;; point may hand it -c/-r/--session instead of refusing them by name.
  {:bundles [[:bundle/minimal {}]]
   :rows [{:id :mode-tui :plugin kmet.ui.tui/plugin :mode true
          :session-lifecycle true}]
   :patch []}

  ;; print is the first profile with a mode row: one prompt, one run, its text
  ;; on stdout, the exit code in `kmet.app.core`. `:mode true` marks the row the
  ;; entry point hands the invocation's input to (the prompt, where to report).
  :print
  {:bundles [[:bundle/minimal {}] [:bundle/headless {}]]
   :rows [{:id :mode-print :plugin kmet.app.modes.print/plugin
          :mode true :prompt true}]
   :patch []}

  ;; rpc is the same rows with a mode that serves a protocol instead of a
  ;; prompt: one agent, its events as the wire projection, commands on stdin.
  ;; No :prompt — a bare `--profile rpc` is legal and waits on stdin.
  :rpc
  {:bundles [[:bundle/minimal {}] [:bundle/headless {}]]
   :rows [{:id :mode-rpc :plugin kmet.app.modes.rpc/plugin :mode true}]
   :patch []}

  ;; rpc with the gate mounted: every tool call is asked about. No answering
  ;; surface yet, so the bundle's default approver denies — which is the point
  ;; of naming the policy rather than assuming allow. A profile that stacks a
  ;; bundle rather than reaching into it.
  :rpc-ask
  {:bundles [[:bundle/minimal {}] [:bundle/headless {}] [:bundle/gated {}]]
   :rows [{:id :mode-rpc :plugin kmet.app.modes.rpc/plugin :mode true}]
   :patch []}

  ;; server is rpc over a socket: one agent per connection, every record badged
  ;; with its agent's id. `--port` picks the socket (0 asks the OS for one, and
  ;; the mode announces it as a `:listening` record). The approvals row is the
  ;; server's own: a run's `:ask` becomes a `:request` the client answers. The
  ;; *policy* stays the bundle's default (allow) — a profile that wants the gate
  ;; mounted patches in `{:id :permissions :plugin kmet.app.permissions/permissions
  ;; :config {:policy :ask-all}}`.
  :server
  {:bundles [[:bundle/minimal {}] [:bundle/headless {}]]
   :rows [{:id :mode-server :plugin kmet.app.modes.server/plugin :mode true}]
   :patch [{:id :approvals :plugin kmet.app.modes.server/approvals}]}}}
