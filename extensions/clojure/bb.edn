{:paths ["src" "test" "../../src"]
 :deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"
                                :exclusions [rewrite-clj/rewrite-clj]}
        parinferish/parinferish {:mvn/version "0.8.0"}
        ;; clojure-edit loads kmet.app.ui.tool-renderers (../../src), whose
        ;; kmet.libs.json seam requires clojure.data.json — bb >= 1.13.224
        ;; bundles it (the built-in wins), declared here for a standalone
        ;; classpath and version-aligned with the root deps.edn.
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :tasks
 {test {:doc "Run clojure extension tests (args: test namespace names)"
        :task (let [nss (or (some->> *command-line-args* (map symbol))
                            '[kmet.extensions.clojure.edit-util-test
                              kmet.extensions.clojure.edit-tool-test
                              kmet.extensions.clojure.sexp-tool-test
                              kmet.extensions.clojure.paren-repair-test
                              kmet.extensions.clojure.nrepl-test
                              kmet.extensions.clojure.eval-tool-test])]
                (doseq [ns-sym nss]
                  (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}}}
