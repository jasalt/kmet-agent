{:paths ["src" "test"
         "../../modules/cells/src" "../../modules/reakt/src"
         "../../modules/hikap/src" "../../modules/libs/src"
         "../../modules/tui/src" "../../modules/ai/src"
         "../../modules/agent/src" "../../modules/loader/src"
         "../../modules/tk/src"]
 :tasks
 {test {:doc "Run review extension tests (args: test namespace names)"
        :task (let [nss (or (some->> *command-line-args* (map symbol))
                            '[kmet.extensions.review.prompts-test
                              kmet.extensions.review.git-test
                              kmet.extensions.review.review-test])]
                (doseq [ns-sym nss]
                  (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}}}
