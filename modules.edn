;; The workspace manifest — see tasks/kmet/tasks/modules.clj for the readers.
;;
;; Classpath and embed order is the listing order (it decides shadowing);
;; :rank is the layering guard's ordering (kmet.test-module-deps). Each
;; module's modules/<name>/deps.edn declares every module its src requires and
;; nothing neither src nor test uses — the same guard checks both directions.
;; Extension projects are not workspace modules: each is an independently
;; loadable extension with its own bb.edn test entry (and, when it needs
;; library deps, a deps.edn).
{:modules
 [{:name "reakt" :src "modules/reakt/src" :test "modules/reakt/test" :rank 0}
  {:name "hikap" :src "modules/hikap/src" :test "modules/hikap/test" :rank 1}
  {:name "libs" :src "modules/libs/src" :test "modules/libs/test" :rank 0}
  {:name "tui" :src "modules/tui/src" :test "modules/tui/test" :rank 2}
  {:name "ai" :src "modules/ai/src" :test "modules/ai/test" :rank 1}
  ;; agent is kmet1, the legacy app: rank 4 so it may reach the lifted app (2)
  ;; and, from landing 5, the new front ends (3). Its inversion ends with the
  ;; module, when kmet2 passes the full gate set and kmet1 is retired.
  {:name "agent" :src "modules/agent/src" :test "modules/agent/test" :rank 4}
  {:name "loader" :src "modules/loader/src" :test "modules/loader/test" :rank 0}
  {:name "srce" :src "modules/srce/src" :test "modules/srce/test" :rank 1}
  ;; The kmet2 application: shared services, the session layer and the
  ;; extension host (new-app.md). Its files may keep a kmet.agent.* namespace
  ;; when a lift moves them here — the module changes, the name does not.
  {:name "app" :src "modules/app/src" :test "modules/app/test" :rank 2}
  ;; tk is the Tk backend plus its kmet.gui-sample.* widget skeleton (one
  ;; `:ui/transcript` composite over the backend's extra-tag seam). No module
  ;; depends on it: the agent module deliberately carries no Tk dependency.
  {:name "tk" :src "modules/tk/src" :test "modules/tk/test" :rank 2}]

 :extension-root "extensions"
 :extensions
 [{:name "clojure" :src "extensions/clojure/src" :test "extensions/clojure/test"}
  {:name "tree-sitter" :src "extensions/tree-sitter/src" :test "extensions/tree-sitter/test"}
  {:name "review" :src "extensions/review/src" :test "extensions/review/test"}]

 ;; Classpath roots beyond the module and extension trees; :test marks the root
 ;; that holds tests (the runner scans module test dirs, this root, and the
 ;; extension test dirs).
 :roots [{:path "test" :test true} {:path "tasks"}]

 ;; jolt's :jolt/build :embed packager roots beside the module sources.
 :jolt-embed-extra ["target/kmet-version" "target/kmet-bundled"]}
